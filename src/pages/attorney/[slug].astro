---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleHero from '@/components/articles/ArticleHero.astro';
import ArticleContent from '@/components/articles/ArticleContent.astro';
import ArticleStats from '@/components/articles/ArticleStats.astro';
import ArticleContactForm from '@/components/articles/ArticleContactForm.astro';
import ArticleTestimonials from '@/components/articles/ArticleTestimonials.astro';
import ArticleMap from '@/components/articles/ArticleMap.astro';

export async function getStaticPaths() {
  const attorneys = await getCollection('attorneys');
  return attorneys.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'attorneys'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalUrl={data.canonicalUrl}
>
  <ArticleHero
    variant="simple"
    title={data.heroTitle}
    description={data.heroDescription}
  />

  {data.profileVariant === 'article' ? (
    <>
      <ArticleContent><Content /></ArticleContent>
      <ArticleStats />
      <ArticleContactForm />
      <ArticleTestimonials />
      <ArticleMap />
    </>
  ) : (
    <section class="bg-background py-12">
      <div class="max-w-[1440px] mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <div class="lg:col-span-8 space-y-8">
            <Content />

            <div>
              <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mb-4">Education</h2>
              <ul class="space-y-3">
                {data.education.map((education) => (
                  <li class="text-[16px] text-foreground leading-[1.6]">
                    <strong>{education.school}</strong><br />
                    <span class="text-muted-foreground">{education.details}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mb-4">Bar Admissions</h2>
              <ul class="space-y-2">
                {data.barAdmissions.map((item) => <li class="text-[16px] text-foreground leading-[1.6]">• {item}</li>)}
              </ul>
            </div>

            <div>
              <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mb-4">Professional Associations</h2>
              <ul class="space-y-2">
                {data.professionalAssociations.map((item) => <li class="text-[16px] text-foreground leading-[1.6]">• {item}</li>)}
              </ul>
            </div>

            <div>
              <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mb-4">Representative Cases</h2>
              <ul class="space-y-3">
                {data.representativeCases.map((item) => <li class="text-[16px] text-foreground leading-[1.6]">• {item}</li>)}
              </ul>
            </div>

            <div>
              <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mb-4">Classes &amp; Seminars</h2>
              <ul class="space-y-3">
                {data.classesAndSeminars.map((item) => <li class="text-[16px] text-foreground leading-[1.6]">• {item}</li>)}
              </ul>
            </div>
          </div>

          <aside class="lg:col-span-4 space-y-8">
            <div class="bg-[hsl(0,0%,97%)] p-6 rounded-[8px] border border-black/5 space-y-4 sticky top-6">
              <h3 class="text-[22px] font-bold text-foreground text-center">Contact</h3>
              <div class="space-y-3">
                <a href="/free-consultation" class="block w-full bg-primary text-white text-center px-5 py-3 rounded-[4px] font-medium hover:bg-primary-hover transition-colors">
                  Schedule a Free Consultation
                </a>
                <a href="tel:+17349940200" class="block w-full bg-secondary text-secondary-foreground text-center px-5 py-3 rounded-[4px] font-medium hover:bg-secondary-hover transition-colors">
                  Call (734) 994-0200
                </a>
              </div>
              <hr class="border-black/10" />
              <div>
                <h4 class="text-[16px] font-semibold mb-2">Office Location</h4>
                <p class="text-[14px] text-muted-foreground leading-[1.6]">
                  2950 S. State ST. STE 400<br />
                  Ann Arbor, MI 48104
                </p>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
