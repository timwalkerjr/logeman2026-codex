---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleHero from '@/components/articles/ArticleHero.astro';
import ArticleContent from '@/components/articles/ArticleContent.astro';
import ArticleFAQ from '@/components/articles/ArticleFAQ.astro';
import ArticleStats from '@/components/articles/ArticleStats.astro';
import StatsBar from '@/components/articles/StatsBar.astro';
import ArticleContactForm from '@/components/articles/ArticleContactForm.astro';
import FreeConsultationForm from '@/components/home/FreeConsultationForm.astro';
import ArticleTestimonials from '@/components/articles/ArticleTestimonials.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import ArticleMap from '@/components/articles/ArticleMap.astro';
import LocationMap from '@/components/home/LocationMap.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const practiceAreas = await getCollection('practiceAreas');
  const practiceAreasById = new Map(practiceAreas.map((entry) => [entry.id, entry]));

  return articles.map((entry) => {
    const heroPracticeArea = practiceAreasById.get(entry.data.heroPracticeArea);
    if (!heroPracticeArea) {
      throw new Error(`Article ${entry.id} maps to missing practice area ${entry.data.heroPracticeArea}`);
    }

    return {
      params: { slug: entry.id },
      props: { entry, heroPracticeArea },
    };
  });
}

interface Props {
  entry: CollectionEntry<'articles'>;
  heroPracticeArea: CollectionEntry<'practiceAreas'>;
}

const { entry, heroPracticeArea } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  heroTitle,
  heroDescription,
  canonicalUrl,
  ctaHeadline,
  ctaText,
  ctaButtonText,
  ctaButtonLink,
  faqs,
  statsVariant,
  formVariant,
  testimonialsVariant,
  mapVariant,
} = entry.data;
const {
  heroEyebrow,
  heroImage,
  heroImageSrcset,
  heroImageAlt,
} = heroPracticeArea.data;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  canonicalUrl={canonicalUrl}
>
  <ArticleHero
    title={heroTitle}
    eyebrow={heroEyebrow}
    description={heroDescription}
    image={heroImage}
    imageSrcset={heroImageSrcset.join(', ')}
    imageAlt={heroImageAlt}
  />

  <ArticleContent
    ctaHeadline={ctaHeadline}
    ctaText={ctaText}
    ctaButtonText={ctaButtonText}
    ctaButtonLink={ctaButtonLink}
  >
    <Content />
  </ArticleContent>

  <ArticleFAQ items={faqs} />

  {statsVariant === 'article' ? <ArticleStats /> : <StatsBar />}
  {formVariant === 'home' ? <FreeConsultationForm /> : <ArticleContactForm />}
  {testimonialsVariant === 'home' ? <Testimonials /> : <ArticleTestimonials />}
  {mapVariant === 'article' && <ArticleMap />}
  {mapVariant === 'location' && <LocationMap />}
</BaseLayout>
