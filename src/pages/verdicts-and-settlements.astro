---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleHero from '@/components/articles/ArticleHero.astro';
import ArticleContent from '@/components/articles/ArticleContent.astro';
import StatsBar from '@/components/articles/StatsBar.astro';
import ArticleContactForm from '@/components/articles/ArticleContactForm.astro';
import ArticleTestimonials from '@/components/articles/ArticleTestimonials.astro';
import ArticleMap from '@/components/articles/ArticleMap.astro';

const verdicts = (await getCollection('verdicts')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Personal Injury Case Results | Logeman & Iafrate, P.C."
  description="Review notable verdicts and settlements secured by Logeman & Iafrate for Michigan injury victims. Our trial-ready approach delivers proven results."
  canonicalUrl="https://www.logeman.com/verdicts-and-settlements/"
>
  <ArticleHero
    variant="simple"
    title="Our Results Matter to Our Injured Clients"
    description="Personal injury attorney with three decades of experience fighting for injured clients in Michigan. He's known for compassionate and aggressive legal representation for injury victims."
  />

  <ArticleContent>
    <h2>We are fierce trial ready advocates for our injured clients with a track record built in the courtroom.</h2>
    <p>Many personal injury firms settle quickly to avoid the work of trial preparation. We take a different approach. Our verdicts and settlements reflect decades of fighting for injured clients throughout Michigan—in Washtenaw, Wayne, Livingston, Jackson, and Calhoun counties. When insurance companies see our name on a case, they know we're prepared to go the distance. That preparation shows in our results, from a $5.1 million verdict for a woman killed by a semi truck to a $1.3 million malicious prosecution award against a township that abused its authority.</p>

    <h3>Fighting Insurance Company Denials</h3>
    <p>Insurance companies routinely deny legitimate claims, hoping injured people will give up. They argue that injuries stem from "unrelated" conditions, that treatment is "unnecessary," or that coverage doesn't apply. We've heard every excuse—and we've beaten them. Our results include a $2 million settlement for a traumatic brain injury victim whose insurer denied all benefits, a $1 million verdict against Amerisure for a man they fought for 18 years, and jury awards against Allstate, State Farm, Farmers, and Auto-Owners when they refused to pay for the care our clients needed.</p>

    <h3>No-Fault Benefits Your Insurer Owes You</h3>
    <p>Michigan's no-fault system entitles accident victims to coverage for medical expenses, attendant care, and home modifications—but collecting those benefits often requires a fight. We've recovered millions in first-party claims, securing not just past-due benefits but future coverage for clients who need ongoing care. From a $730,000 settlement against Esurance to lifetime medical coverage awarded by a Washtenaw County jury, we make sure insurers honor their obligations.</p>

    <h2>Here's a few of our recent verdicts and settlements:</h2>

    {verdicts.map((verdict) => (
      <>
        <h3>{verdict.data.title}</h3>
        <p>{verdict.data.description}</p>
        <h4>{verdict.data.amount}</h4>
      </>
    ))}

    <p class="text-[14px] text-muted-foreground italic mt-8">Past results do not guarantee future outcomes. Each case is decided on its own facts.</p>

    <h2>Our Story — Built on Experience and Determination</h2>
    <p>For decades, Logeman & Iafrate has represented injured clients across Michigan with unwavering commitment. We take cases others won't, and we win cases others can't. Our founders built this firm on a simple principle: injured people deserve fierce advocacy and real results.</p>

    <p class="text-[14px] text-muted-foreground italic mt-8">This article is provided for informational purposes only and does not constitute legal advice. Consult a qualified attorney at Logeman & Iafrate, P.C. for advice regarding your individual situation.</p>
  </ArticleContent>

  <StatsBar />

  <ArticleContactForm />

  <ArticleTestimonials />

  <ArticleMap />
</BaseLayout>
