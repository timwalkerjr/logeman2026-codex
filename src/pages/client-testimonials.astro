---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleHero from '../components/articles/ArticleHero.astro';
import ArticleContent from '@/components/articles/ArticleContent.astro';
import ArticleStats from '../components/articles/ArticleStats.astro';
import ArticleContactForm from '../components/articles/ArticleContactForm.astro';
import ArticleTestimonials from '../components/articles/ArticleTestimonials.astro';
import ArticleMap from '../components/articles/ArticleMap.astro';

const title = "Client Testimonials | Logeman & Iafrate, P.C.";
const description = "Read what past clients say about working with Logeman & Iafrate. Discover why injured Michiganders trust our firm with their personal injury cases.";
const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={title} description={description}>
  <ArticleHero
    title="We are so Grateful for our Clients and their Kind Words"
    description="Personal injury attorney with three decades of experience fighting for injured clients in Michigan. He's known for compassionate and aggressive legal representation for injury victims."
    image="https://pagesmith-cdn.com/881ce63c/images/693497a35eaaff8688ef590f_relume-608351-1024.webp"
    imageSrcset="https://pagesmith-cdn.com/881ce63c/images/693497a35eaaff8688ef590f_relume-608351-640.webp 640w, https://pagesmith-cdn.com/881ce63c/images/693497a35eaaff8688ef590f_relume-608351-1024.webp 1024w"
    imageAlt="Lady Justice holding the scales of justice"
  />
  <ArticleContent>
    <div class="reviews-page-content">
    <h2>These words from the people we've represented remind us why we do this work every day.</h2>

    <p>At Logeman &amp; Iafrate, the relationships we build with our clients mean everything to us. When someone walks through our doors after an accident or injury, they're often facing one of the most difficult times in their lives. It's a privilege to stand beside them, fight for what they deserve, and help them move forward.</p>

    <p>These words from the people we've represented remind us why we do this work every day.</p>

    <h3>Here's a few of our recent reviews:</h3>

    {reviews.map((review) => (
      <blockquote>
        <p><strong>{review.data.name}</strong></p>
        <p>{review.data.text}</p>
        <p><em>{review.data.date}</em></p>
      </blockquote>
    ))}
    </div>
  </ArticleContent>
  <ArticleStats />
  <ArticleContactForm />
  <ArticleTestimonials />
  <ArticleMap />
</BaseLayout>

<style is:global>
  .reviews-page-content blockquote {
    position: relative;
    margin: 0 0 2rem !important;
    border: 0 !important;
    border-radius: 8px;
    background: #eef2f8;
    padding: 2rem 1.75rem 1.75rem !important;
    color: hsl(var(--foreground));
    font-style: normal !important;
    box-shadow: none;
  }

  .reviews-page-content blockquote::before {
    display: block;
    margin-bottom: 1rem;
    color: #fbbb19;
    content: '★★★★★';
    font-family: Arial, sans-serif;
    font-size: 1.5rem;
    font-style: normal;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .reviews-page-content blockquote p {
    margin: 0 !important;
    color: hsl(var(--foreground));
    font-style: normal !important;
  }

  .reviews-page-content blockquote p:first-of-type {
    margin-bottom: 1rem !important;
  }

  .reviews-page-content blockquote p:first-of-type::before,
  .reviews-page-content blockquote p:last-of-type::after {
    content: none !important;
  }

  .reviews-page-content blockquote strong {
    color: hsl(var(--foreground));
    font-size: 1.125rem;
    font-weight: 700;
  }

  .reviews-page-content blockquote p:nth-of-type(2) {
    font-size: 1rem;
    line-height: 1.55;
  }

  .reviews-page-content blockquote p:last-of-type {
    margin-top: 1rem !important;
    text-align: right;
  }

  .reviews-page-content blockquote em {
    color: hsl(var(--foreground));
    font-size: 0.75rem;
    font-style: normal;
  }

  @media (min-width: 768px) {
    .reviews-page-content blockquote {
      padding: 2rem 2rem 1.75rem !important;
    }
  }
</style>
