---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleHero from '@/components/articles/ArticleHero.astro';

const recentNews = [
  {
    title: "Bus Accident Liability in Michigan: Public Transit vs. School Bus Claims",
    excerpt: "Understanding liability in bus accidents, whether involving public transit or school buses, is crucial for those pursuing claims in Michigan. This article delves into the differences and provides guidance for potential claimants.",
    image: "https://pagesmith-cdn.com/881ce63c/images/698257e72b74b9df7dee21e3_f8df0386-ad8b-4702-bcf7-6d9c7c44f03f-1024.webp",
    url: "/posts/bus-accident-liability-in-michigan-public-transit-vs-school-bus-claims"
  },
  {
    title: "Bicycle Accident Claims in Ann Arbor: Bike Lane Laws & Cyclist Rights",
    excerpt: "Ann Arbor, with its extensive bike lanes, continues to see bicycle accidents. Understanding your rights and the legal process can help if you're involved in an accident. Common causes include distracted driving, failure to yield, and dooring.",
    image: "https://pagesmith-cdn.com/881ce63c/images/69810622b1c9dce36dcb9bd1_6cb187e2-b02c-4d94-b63b-15ad73cd3aff-1024.webp",
    url: "/posts/bicycle-accident-claims-in-ann-arbor-bike-lane-laws-cyclist-rights"
  },
  {
    title: "Medical Malpractice Expert Testimony After Danhoff v. Fahim: Michigan Supreme Court Ruling",
    excerpt: "The Michigan Supreme Court's decision in Danhoff v. Fahim highlights the crucial role of expert testimony in medical malpractice cases. This ruling affects how standards of care are assessed and the criteria for expert witnesses in Michigan.",
    image: "https://pagesmith-cdn.com/881ce63c/images/697fb45d95fe14daeaa2dc66_1d430d08-bbd0-408f-89b4-ac00db2920f5-1024.webp",
    url: "/posts/medical-malpractice-expert-testimony-after-danhoff-v-fahim-michigan-supreme-court-ruling"
  },
  {
    title: "Proving Lost Wages in Michigan Personal Injury Cases: Documentation & Calculation",
    excerpt: "Lost wages in Michigan personal injury cases can significantly impact victims' finances. Understanding how to document and calculate these losses is essential to obtaining fair compensation.",
    image: "https://pagesmith-cdn.com/881ce63c/images/697d33fcbb0913929376fb73_00b238e1-f0b2-497a-a9ff-130dba896e37-1024.webp",
    url: "/posts/proving-lost-wages-in-michigan-personal-injury-cases-documentation-calculation"
  },
  {
    title: "Commercial Truck Accident Claims: Federal Regulations & Trucking Company Liability",
    excerpt: "Understanding commercial truck accidents involves navigating federal regulations and liability issues. This article examines these complexities and the role of legal representation in ensuring victims' rights.",
    image: "https://pagesmith-cdn.com/881ce63c/images/696fe2aee5ea9dfb7ff3ff27_76bc4796-a98b-4127-bdf1-474c47927955-1024.webp",
    url: "/posts/commercial-truck-accident-claims-federal-regulations-trucking-company-liability"
  },
  {
    title: "Product Liability in Michigan: Defective Products & Manufacturing Defect Claims",
    excerpt: "Michigan product liability law ensures accountability for defective products. This article covers the legal landscape, focusing on lawsuits and manufacturing defect claims.",
    image: "https://pagesmith-cdn.com/881ce63c/images/697bc29cadd449a0f7d25045_f1d20dd1-d28d-4d04-9f4a-94ae572aca10-1024.webp",
    url: "/posts/product-liability-in-michigan-defective-products-manufacturing-defect-claims"
  }
];

const articleEntries = (await getCollection('articles')).sort((a, b) => {
  const orderA = a.data.featuredOrder ?? Number.MAX_SAFE_INTEGER;
  const orderB = b.data.featuredOrder ?? Number.MAX_SAFE_INTEGER;

  return orderA - orderB || a.data.heroTitle.localeCompare(b.data.heroTitle);
});
---

<BaseLayout
  title="Personal Injury Legal Resources | Logeman & Iafrate Blog"
  description="Explore articles on Michigan personal injury law, no-fault insurance, and your legal rights. Stay informed with insights from our experienced attorneys."
  canonicalUrl="https://www.logeman.com/articles-posts/"
>
  <ArticleHero
    variant="background"
    eyebrow="Compassionate And Aggressive Legal Representation For Injury Victims"
    title="Recent Articles and Posts"
    description="When you face the aftermath of an accident, navigating through your personal injury claim can feel overwhelming and complex while trying to heal from physical injuries. At Logeman & Iafrate, P.C., in Ann Arbor, we understand the physical, emotional and financial toll an injury can take on you and your family. That is why we dedicate ourselves to advocating for your rights and securing the compensation you deserve."
    image="https://pagesmith-cdn.com/881ce63c/images/693ae3bfbd437f799d63087e_0-1024.webp"
    imageAlt="Logeman & Iafrate attorneys"
  />
  <section class="bg-background py-12">
    <div class="max-w-[1440px] mx-auto px-6">
      <h2 class="text-[36px] font-bold text-foreground leading-[1.3] mb-6">
        Personal Injury Legal Resources
      </h2>
      <p class="text-[16px] text-foreground leading-[1.6] mb-12">
        We have over 6 decades of combined personal injury law success.
      </p>

      <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mb-4">
        Recent Injury Related Articles
      </h2>
      <p class="text-[16px] text-foreground leading-[1.6] mb-8">
        We handle personal injury law cases in Michigan. We take on the tough cases other firms pass on.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articleEntries.map((entry) => (
          <article class="bg-[rgba(229,236,246,0.54)] rounded-[8px] overflow-hidden border border-white/60 hover-lift">
            <a href={`/articles/${entry.id}`} class="block">
              <img
                src={entry.data.cardImage}
                alt={entry.data.heroTitle}
                class="w-full h-[200px] object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-[20px] font-semibold text-foreground mb-3 leading-[1.4]">
                  {entry.data.heroTitle}
                </h3>
                <p class="text-[14px] text-foreground leading-[1.6] mb-4">
                  {entry.data.excerpt}
                </p>
                <span class="text-primary font-medium text-[14px] inline-flex items-center gap-1">
                  Learn More →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mt-16 mb-4">
        Recent News and Posts
      </h2>
      <p class="text-[16px] text-foreground leading-[1.6] mb-8">
        We handle personal injury law cases in Michigan. We take on the tough cases other firms pass on.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentNews.map((post) => (
          <article class="bg-[rgba(229,236,246,0.54)] rounded-[8px] overflow-hidden border border-white/60 hover-lift">
            <a href={post.url} class="block">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-[200px] object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-[20px] font-semibold text-foreground mb-3 leading-[1.4]">
                  {post.title}
                </h3>
                <p class="text-[14px] text-foreground leading-[1.6] mb-4">
                  {post.excerpt}
                </p>
                <span class="text-primary font-medium text-[14px] inline-flex items-center gap-1">
                  Learn More →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
