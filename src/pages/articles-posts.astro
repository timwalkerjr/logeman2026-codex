<BaseLayout
  title="Personal Injury Legal Resources | Logeman & Iafrate Blog"
  description="Explore articles on Michigan personal injury law, no-fault insurance, and your legal rights. Stay informed with insights from our experienced attorneys."
  canonicalUrl="https://www.logeman.com/articles-posts/"
>
  <ArticleHero
    variant="background"
    eyebrow="Compassionate And Aggressive Legal Representation For Injury Victims"
    title="Recent Articles and Posts"
    description="When you face the aftermath of an accident, navigating through your personal injury claim can feel overwhelming and complex while trying to heal from physical injuries. At Logeman & Iafrate, P.C., in Ann Arbor, we understand the physical, emotional and financial toll an injury can take on you and your family. That is why we dedicate ourselves to advocating for your rights and securing the compensation you deserve."
    image="https://pagesmith-cdn.com/881ce63c/images/693ae3bfbd437f799d63087e_0-1024.webp"
    imageAlt="Logeman & Iafrate attorneys"
  />
  <section class="bg-background py-12">
    <div class="max-w-[1440px] mx-auto px-6">
      <h2 class="text-[36px] font-bold text-foreground leading-[1.3] mb-6">
        Personal Injury Legal Resources
      </h2>
      <p class="text-[16px] text-foreground leading-[1.6] mb-12">
        We have over 6 decades of combined personal injury law success.
      </p>

      <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mb-4">
        Recent Injury Related Articles
      </h2>
      <p class="text-[16px] text-foreground leading-[1.6] mb-8">
        We handle personal injury law cases in Michigan. We take on the tough cases other firms pass on.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentArticles.map((article) => (
          <article class="bg-[rgba(229,236,246,0.54)] rounded-[8px] overflow-hidden border border-white/60 hover-lift">
            <a href={article.url} class="block">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-[200px] object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-[20px] font-semibold text-foreground mb-3 leading-[1.4]">
                  {article.title}
                </h3>
                <p class="text-[14px] text-foreground leading-[1.6] mb-4">
                  {article.excerpt}
                </p>
                <span class="text-primary font-medium text-[14px] inline-flex items-center gap-1">
                  Learn More →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <h2 class="text-[26px] font-bold text-foreground leading-[1.3] mt-16 mb-4">
        Recent News and Posts
      </h2>
      <p class="text-[16px] text-foreground leading-[1.6] mb-8">
        We handle personal injury law cases in Michigan. We take on the tough cases other firms pass on.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentNews.map((post) => (
          <article class="bg-[rgba(229,236,246,0.54)] rounded-[8px] overflow-hidden border border-white/60 hover-lift">
            <a href={post.url} class="block">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-[200px] object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-[20px] font-semibold text-foreground mb-3 leading-[1.4]">
                  {post.title}
                </h3>
                <p class="text-[14px] text-foreground leading-[1.6] mb-4">
                  {post.excerpt}
                </p>
                <span class="text-primary font-medium text-[14px] inline-flex items-center gap-1">
                  Learn More →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
