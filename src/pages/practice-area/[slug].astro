---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleHero from '@/components/articles/ArticleHero.astro';
import ArticleContent from '@/components/articles/ArticleContent.astro';
import ArticleFAQ from '@/components/articles/ArticleFAQ.astro';
import ArticleContactForm from '@/components/articles/ArticleContactForm.astro';
import ArticleTestimonials from '@/components/articles/ArticleTestimonials.astro';
import ArticleMap from '@/components/articles/ArticleMap.astro';

export async function getStaticPaths() {
  const practiceAreas = await getCollection('practiceAreas');

  return practiceAreas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'practiceAreas'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  heroTitle,
  heroEyebrow,
  heroDescription,
  heroImage,
  heroImageSrcset,
  heroImageAlt,
  canonicalUrl,
  faqs,
} = entry.data;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  canonicalUrl={canonicalUrl}
>
  <ArticleHero
    title={heroTitle}
    eyebrow={heroEyebrow}
    description={heroDescription}
    image={heroImage}
    imageSrcset={heroImageSrcset.join(', ')}
    imageAlt={heroImageAlt}
  />

  <ArticleContent>
    <Content />
    {faqs.length > 0 && <ArticleFAQ slot="after" items={faqs} embedded />}
  </ArticleContent>

  <ArticleTestimonials />
  <ArticleContactForm />
  <ArticleMap />
</BaseLayout>
