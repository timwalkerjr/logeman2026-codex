  },
  {
    slug: 'washtenaw-county-mi',
    eyebrow: 'Washtenaw County Personal Injury Lawyers | Michigan Accident Attorneys',
    name: 'Washtenaw County, MI',
    description: 'Logeman & Iafrate, P.C. provides experienced personal injury representation to injured clients throughout Washtenaw County. We take cases others will not and prepare every case for trial.',
    mapUrl: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d377915.17926936893!2d-83.91095552251578!3d42.268653157068464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x883cb00dd4431f33%3A0x6ec9ae99b955b1b8!2sWashtenaw%20County%2C%20MI!5e0!3m2!1sen!2sus!4v1782312140508!5m2!1sen!2sus',
  },
  {
    slug: 'wayne-county-mi',
    eyebrow: 'Wayne County Personal Injury Lawyers | Detroit Accident Attorneys',
    name: 'Wayne County, MI',
    description: 'Logeman & Iafrate, P.C. represents injured people throughout Wayne County, Michigan—from Detroit to Dearborn, Livonia, and the Downriver communities. We take cases others will not and prepare every case for trial.',
    mapUrl: 'https://www.google.com/maps?q=Wayne%20County%2C%20MI&output=embed',
  },
];

const faqs = [
  {
    question: 'What cases do you handle?',
    answer: 'We represent clients in personal injury, wrongful death, auto accidents, premises liability, medical malpractice, and other serious injury cases throughout Michigan. Our attorneys have decades of experience fighting for injured people and their families.',
  },
  {
    question: 'Do I pay upfront fees?',
    answer: 'No. We work on a contingency-fee basis, meaning you pay no legal fee unless we recover damages for you. The initial consultation is free.',
  },
  {
    question: 'How long does a case take?',
    answer: 'Every case is different. Some settle quickly while others require trial. We will keep you informed at every step and work at the pace that best serves your interests.',
  },
  {
    question: 'Will my case go to trial?',
    answer: 'We prepare every case for trial and are ready to take your case to court when necessary. Many cases settle, but we do not back down when a trial is the best path forward.',
  },
  {
    question: 'What should I do after an accident?',
    answer: 'Seek medical attention first, document everything you can about the incident, and avoid giving recorded statements to an insurer before getting advice. Then contact us for a free consultation so we can help protect your rights.',
  },
];
---

<BaseLayout
  title="Service Areas | Logeman & Iafrate, P.C."
  description="Logeman & Iafrate represents injured clients across Southeast Michigan, including Ann Arbor, Brighton, Jackson, and surrounding counties. Free consultation."
  canonicalUrl="https://www.logeman.com/service-areas/"
>
  <ArticleHero
    variant="background"
    eyebrow="Compassionate And Aggressive Legal Representation For Injury Victims"
    title="Our Firm's Service Areas"
    description="Our attorneys, James A. Iafrate and Adrienne D. Logeman, share over 60 years of combined experience representing injured clients in Ann Arbor and throughout Southeast Michigan."
    image="https://pagesmith-cdn.com/881ce63c/images/693ae3bfbd437f799d63087e_0-1024.webp"
    imageAlt="Ann Arbor office building and fountain"
    primaryCtaHref="#free-consultation"
    secondaryCtaHref="/contact-us/"
  />

  <section class="bg-background py-16 lg:py-20">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-10">
      <p class="mb-5 text-[14px] font-medium text-primary">We have over six decades of combined personal injury law success.</p>
      <div class="mb-10 max-w-[860px]">
        <h2 class="mb-4 font-serif text-[36px] font-bold leading-[1.2] tracking-[-0.02em] text-foreground lg:text-[42px]">Our Michigan Service Areas</h2>
        <p class="text-[17px] leading-[1.7] text-muted-foreground">We handle personal injury law cases across Southeast Michigan. We take on the tough cases other firms pass on.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {serviceAreas.map((area) => (
          <article class="flex h-full flex-col overflow-hidden rounded-[8px] border border-black/5 bg-[rgba(229,236,246,0.62)] shadow-sm transition-transform duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="h-[220px] overflow-hidden bg-secondary">
              <iframe
                src={area.mapUrl}
                title={`Map of ${area.name}`}
                class="h-full w-full border-0"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                tabindex="-1"
              ></iframe>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="mb-2 text-[12px] font-medium leading-[1.45] text-primary">{area.eyebrow}</p>
              <h3 class="mb-3 font-serif text-[24px] font-bold leading-[1.25] text-foreground">{area.name}</h3>
              <p class="mb-6 flex-1 text-[15px] leading-[1.65] text-foreground/80">{area.description}</p>
              <a
                href={`/service-area/${area.slug}/`}
                class="inline-flex w-fit items-center gap-2 rounded-[4px] bg-white px-4 py-2.5 text-[14px] font-semibold text-foreground no-underline shadow-sm transition-colors hover:bg-primary hover:text-white"
              >
                Learn More <span aria-hidden="true">›</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ArticleTestimonials limit={3} />

  <ArticleContactForm />

  <section class="bg-[rgba(229,236,246,0.54)] py-20">
    <div class="mx-auto max-w-[1000px] px-6">
      <div class="mb-12">
        <h2 class="mb-3 font-serif text-[36px] font-bold leading-[1.3] text-foreground">Frequently Asked Questions</h2>
        <p class="text-[17px] text-muted-foreground">Find answers to common questions about our services and process.</p>
      </div>

      <div class="space-y-4">
        {faqs.map((item) => (
          <details class="group rounded-[8px] border border-black/5 bg-white p-6 shadow-sm [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[17px] font-semibold text-foreground">
              <span>{item.question}</span>
              <span class="font-sans text-[26px] font-light text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 max-w-[860px] text-[15px] leading-[1.7] text-foreground/80">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="mt-14 text-center">
        <h3 class="mb-3 font-serif text-[22px] font-bold text-foreground">Still have questions?</h3>
        <p class="mb-6 text-[16px] text-muted-foreground">Reach out to us directly for answers.</p>
        <a href="#free-consultation" class="inline-flex items-center rounded-[4px] bg-primary px-6 py-3 text-[16px] font-medium text-white no-underline transition-colors hover:bg-primary-hover">Schedule a Free Consultation</a>
      </div>
    </div>
  </section>

  <ArticleMap />
</BaseLayout>
