---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleHero from '@/components/articles/ArticleHero.astro';
import ArticleContactForm from '@/components/articles/ArticleContactForm.astro';
import ArticleTestimonials from '@/components/articles/ArticleTestimonials.astro';
import ArticleMap from '@/components/articles/ArticleMap.astro';

const serviceAreas = [
  {
    slug: 'ann-arbor-mi',
    eyebrow: 'Ann Arbor Personal Injury Lawyers | Michigan Accident Attorneys',
    name: 'Ann Arbor, MI',
    description: "Logeman & Iafrate has stood with injured Ann Arbor residents for more than 45 years. We're trial-ready personal injury attorneys who take cases other lawyers have turned down and prepare every case for trial.",
    mapUrl: 'https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d94474.17089513635!2d-83.73459928047954!3d42.27173815813427!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x883cafbf8ff9d311%3A0xf9fba0d4da3f17e4!2sLogeman%20%26%20Iafrate%2C%20P.C.!5e0!3m2!1sen!2sus!4v1782312043019!5m2!1sen!2sus',
  },
  {
    slug: 'brighton-mi',
    eyebrow: 'Brighton Personal Injury Lawyers | Livingston County Attorneys',
    name: 'Brighton, MI',
    description: "Logeman & Iafrate has stood with injured Brighton and Livingston County residents for more than 45 years. We're trial-ready personal injury attorneys who take cases other lawyers turned down and prepare every case for trial.",
    mapUrl: 'https://www.google.com/maps?q=Brighton%2C+MI&output=embed',
  },
  {
    slug: 'calhoun-county-mi',
    eyebrow: 'Calhoun County Personal Injury Attorneys | Battle Creek Accident Lawyers',
    name: 'Calhoun County, MI',
    description: 'Logeman & Iafrate serves injured clients throughout Calhoun County with more than 45 years of courtroom experience. We hold insurance companies accountable, prepare every case for trial, and work on a contingency-fee basis—no fee unless we win.',
    mapUrl: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d378049.0813834444!2d-85.33421426679948!3d42.246313408783706!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8817f47db53de9a9%3A0xaa0d3b692292b3bd!2sCalhoun%20County%2C%20MI!5e0!3m2!1sen!2sus!4v1782312455870!5m2!1sen!2sus',
  },
  {
    slug: 'jackson-county-mi',
    eyebrow: 'Jackson County Personal Injury Lawyers | Michigan Accident Attorneys',
    name: 'Jackson County, MI',
    description: 'Logeman & Iafrate serves Jackson County with experienced personal injury representation, taking cases other lawyers have turned down and preparing every case for trial. Our decades of courtroom experience mean insurers know we are ready to try a case.',
    mapUrl: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d378041.14079226146!2d-84.75435170701363!3d42.2476384559898!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x883cdf6129a2ce41%3A0xf94e059348b7f752!2sJackson%20County%2C%20MI!5e0!3m2!1sen!2sus!4v1782312291429!5m2!1sen!2sus',
  },
  {
    slug: 'lenawee-county-mi',
    eyebrow: 'Lenawee County Personal Injury Attorneys | Adrian Accident Lawyers',
    name: 'Lenawee County, MI',
    description: 'Logeman & Iafrate serves injured clients throughout Lenawee County with more than 45 years of courtroom experience. We hold insurance companies accountable, prepare every case for trial, and charge no legal fee unless we win.',
