const faqItems = [
  {
    question: "What is premises liability in Michigan?",
    answer: "Premises liability in Michigan holds property owners accountable for injuries caused by unsafe conditions on their property, particularly in slip and fall cases."
  },
  {
    question: "What are the duties of property owners under Michigan law?",
    answer: "Property owners in Michigan must maintain safe premises, fix hazards promptly, and provide warnings if immediate repairs are not feasible to protect invitees, licensees, and, in certain cases, trespassers."
  },
  {
