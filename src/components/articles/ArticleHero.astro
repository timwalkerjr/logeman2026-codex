---
interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  image?: string;
  imageSrcset?: string;
  imageAlt?: string;
  variant?: 'split' | 'background' | 'simple';
  showActions?: boolean;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}
const {
  title,
  eyebrow,
  description,
  image,
  imageSrcset,
  imageAlt = '',
  variant,
  showActions,
  primaryCtaText = 'Schedule a Free Consultation',
  primaryCtaHref = '#free-consultation',
  secondaryCtaText = 'Contact Our Team',
  secondaryCtaHref = '/contact-us',
} = Astro.props;

const resolvedVariant = variant ?? (image ? 'split' : 'simple');
const actionsVisible = showActions ?? resolvedVariant !== 'simple';
---
{resolvedVariant === 'simple' ? (
  <header class="bg-dark-background text-white">
    <div class="mx-auto max-w-[1440px] px-6 py-20 lg:px-10 lg:py-24">
      <div class="max-w-[900px]">
        {eyebrow && (
          <p class="mb-5 text-[15px] font-medium leading-[1.5] text-[#75a6d8] sm:text-[17px]">
            {eyebrow}
          </p>
        )}
        {title && (
          <h1 class="font-serif text-[42px] font-bold leading-[1.18] tracking-[-0.02em] text-white sm:text-[48px] lg:text-[52px] lg:leading-[1.25]">
            {title}
          </h1>
        )}
        {description && (
          <p class="mt-8 max-w-[820px] text-[17px] leading-[1.7] text-white/92 sm:text-[18px]">
            {description}
          </p>
        )}
      </div>
    </div>
  </header>
) : resolvedVariant === 'background' ? (
  <header class="relative isolate overflow-hidden bg-dark-background text-white">
    <div class="relative min-h-[570px]">
      {image && (
        <img
          src={image}
          srcset={imageSrcset}
          sizes="100vw"
          alt={imageAlt}
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      )}
      <div class="absolute inset-0 bg-black/30"></div>
      <div
        class="absolute inset-y-0 left-0 w-full bg-dark-background/95 lg:w-[62%]"
        style="clip-path: polygon(0 0, 100% 0, 82% 100%, 0 100%);"
      ></div>

      <div class="relative z-10 mx-auto flex min-h-[570px] max-w-[1440px] items-center px-6 py-16 lg:px-10 lg:py-20">
        <div class="max-w-[690px] lg:w-[54%]">
          {eyebrow && (
            <p class="mb-5 max-w-[560px] text-[15px] font-medium leading-[1.5] text-[#75a6d8] sm:text-[17px]">
              {eyebrow}
            </p>
          )}
          {title && (
            <h1 class="mb-7 max-w-[660px] font-serif text-[42px] font-bold leading-[1.12] tracking-[-0.02em] text-white sm:text-[48px] lg:text-[52px] lg:leading-[1.2]">
              {title}
            </h1>
          )}
          {description && (
            <p class="mb-8 max-w-[620px] text-[17px] leading-[1.7] text-white/92 sm:text-[18px]">
              {description}
            </p>
          )}
          {actionsVisible && (
            <div class="flex flex-col gap-4 sm:flex-row">
              <a href={primaryCtaHref} class="inline-flex min-h-12 items-center justify-center rounded-[3px] bg-primary px-6 py-3 text-center text-[16px] font-semibold text-primary-foreground no-underline transition-colors hover:bg-primary-hover">
                {primaryCtaText}
              </a>
              <a href={secondaryCtaHref} class="inline-flex min-h-12 items-center justify-center rounded-[3px] border border-white/70 bg-white px-6 py-3 text-center text-[16px] font-semibold text-[#011530] no-underline transition-colors hover:bg-secondary">
                {secondaryCtaText}
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </header>
) : (
  <header class="relative isolate overflow-hidden bg-[#001a33] text-white">
    <div class="relative min-h-[620px] lg:min-h-[570px]">
      <div class="absolute inset-y-0 right-0 w-full lg:w-[58%]">
        <img
          src={image}
          srcset={imageSrcset}
          sizes="(min-width: 1024px) 58vw, 100vw"
          alt={imageAlt}
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="absolute inset-0 bg-gradient-to-r from-[#001a33] via-[#001a33]/95 to-[#001a33]/55 lg:hidden"></div>
      <div
        class="absolute inset-y-0 left-0 hidden w-[68%] bg-[#001a33] lg:block"
        style="clip-path: polygon(0 0, 100% 0, 82% 100%, 0 100%);"
      ></div>

      <div class="relative z-10 mx-auto flex min-h-[620px] max-w-[1440px] items-center px-6 py-16 lg:min-h-[570px] lg:px-10 lg:py-20">
        <div class="max-w-[768px] lg:w-[64%]">
          {eyebrow && (
            <p class="mb-5 max-w-[560px] text-[15px] font-medium leading-[1.5] text-[#75a6d8] sm:text-[17px]">
              {eyebrow}
            </p>
          )}
          {title && (
            <h1 class="mb-7 max-w-[768px] font-serif text-[42px] font-bold leading-[1.12] tracking-[-0.02em] text-white sm:text-[48px] lg:text-[52px] lg:leading-[1.25]">
              {title}
            </h1>
          )}
          {description && (
            <p class="mb-8 max-w-[620px] text-[17px] leading-[1.7] text-white/92 sm:text-[18px]">
              {description}
            </p>
          )}
          {actionsVisible && <div class="flex flex-col gap-4 sm:flex-row">
            <a
              href={primaryCtaHref}
              class="inline-flex min-h-12 items-center justify-center rounded-[3px] bg-primary px-6 py-3 text-center text-[16px] font-semibold text-primary-foreground no-underline transition-colors hover:bg-primary-hover"
            >
              {primaryCtaText}
            </a>
            <a
              href={secondaryCtaHref}
              class="inline-flex min-h-12 items-center justify-center rounded-[3px] border border-white/70 bg-white/10 px-6 py-3 text-center text-[16px] font-semibold text-white no-underline backdrop-blur-sm transition-colors hover:bg-white hover:text-[#001a33]"
            >
              {secondaryCtaText}
            </a>
          </div>}
        </div>
      </div>
    </div>
  </header>
)}
