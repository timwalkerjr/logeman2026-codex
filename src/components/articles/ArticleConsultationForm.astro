---
---
<section id="free-consultation" class="py-16 lg:py-20 bg-surface">
  <div class="max-w-[1440px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <img src="https://cdn.prod.website-files.com/693446872c5f1ab9965b1a98/6941b18a1fbcadfc33d9874c_Logo.png" alt="Logeman & Iafrate" class="w-[80px] mb-6" />
        <h3 class="text-[26px] font-bold leading-[1.3] text-foreground mb-4">Schedule a Free Case Review with a Lawyer</h3>
        <p class="text-foreground text-[16px] leading-[1.6] mb-6">Don't face this alone. Let us review your case and show you what's possible. We never charge legal fees unless we recover damages on your behalf and the initial consultation is free as well. Reach out to us today.</p>

        <div class="flex flex-wrap gap-6 mt-8">
          <div class="flex items-center gap-3">
            <img src="https://pagesmith-cdn.com/881ce63c/images/693a55d51fbe67b78602b72b_EV3A7457-Enhanced-NR-1536.webp" alt="Adrienne D. Logeman" class="w-[56px] h-[56px] rounded-full object-cover" />
            <div>
              <div class="text-[15px] font-semibold text-foreground">Adrienne D. Logeman</div>
              <div class="text-[13px] text-muted-foreground">Partner</div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <img src="https://pagesmith-cdn.com/881ce63c/images/693a53edf7b9715e7b7f58e3_james-a-iafrate-bio-photo-1024.webp" alt="James A. Iafrate" class="w-[56px] h-[56px] rounded-full object-cover" />
            <div>
              <div class="text-[15px] font-semibold text-foreground">James A. Iafrate</div>
              <div class="text-[13px] text-muted-foreground">Partner</div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-[rgba(229,236,246,0.54)] p-8 rounded-[8px] border border-white/60">
        <form class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[13px] font-medium text-foreground mb-1.5">First name</label>
              <input type="text" class="w-full px-4 py-2.5 rounded-[4px] border border-black/10 bg-white text-[15px] focus:outline-none focus:border-primary" />
            </div>
            <div>
              <label class="block text-[13px] font-medium text-foreground mb-1.5">Last name</label>
              <input type="text" class="w-full px-4 py-2.5 rounded-[4px] border border-black/10 bg-white text-[15px] focus:outline-none focus:border-primary" />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[13px] font-medium text-foreground mb-1.5">Email</label>
              <input type="email" class="w-full px-4 py-2.5 rounded-[4px] border border-black/10 bg-white text-[15px] focus:outline-none focus:border-primary" />
            </div>
            <div>
              <label class="block text-[13px] font-medium text-foreground mb-1.5">Phone number</label>
              <input type="tel" class="w-full px-4 py-2.5 rounded-[4px] border border-black/10 bg-white text-[15px] focus:outline-none focus:border-primary" />
            </div>
          </div>
          <div>
            <label class="block text-[13px] font-medium text-foreground mb-1.5">What is your case about?</label>
            <div class="flex flex-wrap gap-2">
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="caseType" value="car" class="accent-primary" /> Car Accident
              </label>
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="caseType" value="motorcycle" class="accent-primary" /> Motorcycle Accident
              </label>
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="caseType" value="other" class="accent-primary" /> Other Accident type
              </label>
            </div>
          </div>
          <div>
            <label class="block text-[13px] font-medium text-foreground mb-1.5">How would you describe yourself?</label>
            <div class="flex flex-wrap gap-2">
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="personType" class="accent-primary" /> Injured person
              </label>
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="personType" class="accent-primary" /> Family member
              </label>
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="personType" class="accent-primary" /> Legal representative
              </label>
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="personType" class="accent-primary" /> Insurance company
              </label>
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="personType" class="accent-primary" /> Medical provider
              </label>
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-black/10 rounded-[4px] text-[14px] cursor-pointer hover:border-primary">
                <input type="radio" name="personType" class="accent-primary" /> Other
              </label>
            </div>
          </div>
          <div>
            <label class="block text-[13px] font-medium text-foreground mb-1.5">Message</label>
            <textarea rows="4" placeholder="Tell us more about what happened" class="w-full px-4 py-2.5 rounded-[4px] border border-black/10 bg-white text-[15px] focus:outline-none focus:border-primary resize-vertical"></textarea>
          </div>
          <button type="submit" class="bg-primary text-primary-foreground border border-primary px-8 py-3 rounded-[4px] font-medium text-[16px] hover:bg-primary-hover transition-colors">Submit</button>
        </form>
      </div>
    </div>
  </div>
</section>
