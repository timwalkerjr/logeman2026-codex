---
---
<section id="free-consultation" class="bg-surface py-16">
  <div class="max-w-[1440px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <img src="https://pagesmith-cdn.com/881ce63c/images/6934a8c60a913dd56092ddc6_logeman-webclip-256.webp" alt="Logeman & Iafrate" class="w-[80px] h-auto mb-6" />
        <h2 class="text-[26px] font-bold leading-[1.3] text-foreground tracking-[-0.44px] mb-4">Schedule a Free Case Review with a Lawyer</h2>
        <p class="text-[16px] font-normal leading-[1.6] text-foreground mb-8">Don't face this alone. Let us review your case and show you what's possible. We never charge legal fees unless we recover damages on your behalf and the initial consultation is free as well. Reach out to us today.</p>

        <div class="flex items-start gap-6 mt-8 flex-wrap">
          <a href="#" class="flex items-center gap-3">
            <img src="https://pagesmith-cdn.com/881ce63c/images/693a55d51fbe67b78602b72b_EV3A7457-Enhanced-NR-1536.webp" alt="Adrienne D. Logeman" class="w-[56px] h-[56px] rounded-full object-cover" />
            <div>
              <div class="font-medium text-[14px] text-foreground">Adrienne D. Logeman</div>
              <div class="text-[13px] text-muted-foreground">Partner</div>
            </div>
          </a>
          <a href="/attorney/james-a-iafrate" class="flex items-center gap-3">
            <img src="https://pagesmith-cdn.com/881ce63c/images/693a53edf7b9715e7b7f58e3_james-a-iafrate-bio-photo-1024.webp" alt="James A. Iafrate" class="w-[56px] h-[56px] rounded-full object-cover" />
            <div>
              <div class="font-medium text-[14px] text-foreground">James A. Iafrate</div>
              <div class="text-[13px] text-muted-foreground">Partner</div>
            </div>
          </a>
        </div>
      </div>

      <div class="bg-[rgba(229,236,246,0.54)] p-8 rounded-[8px] border border-white/60">
        <form class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="text" name="firstName" placeholder="First name" class="w-full bg-white border border-border rounded-[4px] px-4 py-3 text-[14px] focus:outline-none focus:border-primary" />
            <input type="text" name="lastName" placeholder="Last name" class="w-full bg-white border border-border rounded-[4px] px-4 py-3 text-[14px] focus:outline-none focus:border-primary" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="email" name="email" placeholder="Email" class="w-full bg-white border border-border rounded-[4px] px-4 py-3 text-[14px] focus:outline-none focus:border-primary" />
            <input type="tel" name="phone" placeholder="Phone number" class="w-full bg-white border border-border rounded-[4px] px-4 py-3 text-[14px] focus:outline-none focus:border-primary" />
          </div>
          <select name="caseType" class="w-full bg-white border border-border rounded-[4px] px-4 py-3 text-[14px] focus:outline-none focus:border-primary">
            <option>What is your case about?</option>
            <option>Car Accident</option>
            <option>Motorcycle Accident</option>
            <option>Truck Accident</option>
            <option>Bicycle Accident</option>
            <option>Brain Injury</option>
            <option>Spinal Cord Injury</option>
            <option>Wrongful Death</option>
            <option>Other Accident type</option>
          </select>

          <fieldset>
            <legend class="text-[14px] font-medium text-foreground mb-2">How would you describe yourself?</legend>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center gap-2 text-[14px]"><input type="radio" name="role" value="injured" class="accent-primary"/> Injured person</label>
              <label class="flex items-center gap-2 text-[14px]"><input type="radio" name="role" value="family" class="accent-primary"/> Family member</label>
              <label class="flex items-center gap-2 text-[14px]"><input type="radio" name="role" value="legal" class="accent-primary"/> Legal representative</label>
              <label class="flex items-center gap-2 text-[14px]"><input type="radio" name="role" value="insurance" class="accent-primary"/> Insurance company</label>
              <label class="flex items-center gap-2 text-[14px]"><input type="radio" name="role" value="medical" class="accent-primary"/> Medical provider</label>
              <label class="flex items-center gap-2 text-[14px]"><input type="radio" name="role" value="other" class="accent-primary"/> Other</label>
            </div>
          </fieldset>

          <textarea name="message" placeholder="Message" rows="4" class="w-full bg-white border border-border rounded-[4px] px-4 py-3 text-[14px] focus:outline-none focus:border-primary"></textarea>

          <button type="submit" class="bg-primary text-primary-foreground border border-primary px-8 py-3 rounded-[4px] font-medium hover:bg-primary-hover transition-colors">Submit</button>
        </form>
      </div>
    </div>
  </div>
</section>
