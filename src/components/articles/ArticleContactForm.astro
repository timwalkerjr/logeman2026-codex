---
const caseTypes = ["Car Accident", "Motorcycle Accident", "Other Accident type"];
const descriptors = ["Injured person", "Family member", "Legal representative", "Insurance company", "Medical provider", "Other"];
---
<section id="free-consultation" class="bg-surface py-16">
  <div class="max-w-[1440px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <img src="https://pagesmith-cdn.com/881ce63c/images/6941b18a1fbcadfc33d9874c_Logo-320.webp" alt="Logeman & Iafrate, P.C." class="w-[80px] h-auto mb-6" />
        <h3 class="text-[26px] font-bold leading-[1.3] text-foreground tracking-[-0.44px] mb-4">Schedule a Free Case Review with a Lawyer</h3>
        <p class="text-[16px] font-normal leading-[1.6] text-foreground mb-6">Don't face this alone. Let us review your case and show you what's possible. We never charge legal fees unless we recover damages on your behalf and the initial consultation is free as well. Reach out to us today.</p>
        <div class="flex items-center gap-6 mt-8">
          <div class="flex items-center gap-3">
            <img src="https://pagesmith-cdn.com/881ce63c/images/693a55d51fbe67b78602b72b_EV3A7457-Enhanced-NR-1536.webp" alt="Adrienne D. Logeman" class="w-[56px] h-[56px] rounded-full object-cover" />
            <div>
              <p class="font-semibold text-[14px] text-foreground">Adrienne D. Logeman</p>
              <p class="text-[12px] text-muted-foreground">Partner</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <img src="https://pagesmith-cdn.com/881ce63c/images/693a53edf7b9715e7b7f58e3_james-a-iafrate-bio-photo-1024.webp" alt="James A. Iafrate" class="w-[56px] h-[56px] rounded-full object-cover" />
            <div>
              <p class="font-semibold text-[14px] text-foreground">James A. Iafrate</p>
              <p class="text-[12px] text-muted-foreground">Partner</p>
            </div>
          </div>
        </div>
      </div>
      <form class="bg-[rgba(229,236,246,0.54)] p-8 rounded-[8px] border border-white/60 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input type="text" name="firstName" placeholder="First name" class="w-full px-4 py-3 rounded-[4px] border border-black/10 bg-white text-[14px] focus:outline-none focus:ring-2 focus:ring-primary" />
          <input type="text" name="lastName" placeholder="Last name" class="w-full px-4 py-3 rounded-[4px] border border-black/10 bg-white text-[14px] focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input type="email" name="email" placeholder="Email" class="w-full px-4 py-3 rounded-[4px] border border-black/10 bg-white text-[14px] focus:outline-none focus:ring-2 focus:ring-primary" />
          <input type="tel" name="phone" placeholder="Phone number" class="w-full px-4 py-3 rounded-[4px] border border-black/10 bg-white text-[14px] focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>
        <div>
          <label class="block text-[14px] font-medium text-foreground mb-2">What is your case about?</label>
          <select name="caseType" class="w-full px-4 py-3 rounded-[4px] border border-black/10 bg-white text-[14px] focus:outline-none focus:ring-2 focus:ring-primary">
            {caseTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-[14px] font-medium text-foreground mb-2">How would you describe yourself?</label>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
            {descriptors.map((d) => (
              <label class="flex items-center gap-2 text-[14px] text-foreground cursor-pointer">
                <input type="radio" name="descriptor" value={d} class="accent-primary" />
                {d}
              </label>
            ))}
          </div>
        </div>
        <div>
          <label class="block text-[14px] font-medium text-foreground mb-2">Message</label>
          <textarea name="message" rows="4" placeholder="Tell us more about what happened" class="w-full px-4 py-3 rounded-[4px] border border-black/10 bg-white text-[14px] focus:outline-none focus:ring-2 focus:ring-primary resize-none"></textarea>
        </div>
        <button type="submit" class="bg-primary text-white px-8 py-3 rounded-[4px] font-medium hover:bg-primary-hover transition-colors">Submit</button>
      </form>
    </div>
  </div>
</section>