    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 max-w-[1000px] mx-auto">
      <div class="text-center">
        <div class="text-[44px] lg:text-[56px] font-bold text-primary leading-none mb-2">60+</div>
        <div class="text-[14px] font-medium text-foreground uppercase tracking-wide">Combined experience</div>
