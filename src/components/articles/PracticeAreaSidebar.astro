---
interface Props {
  ctaHeadline?: string;
  ctaText?: string;
  ctaButtonText?: string;
  ctaButtonLink?: string;
}

const {
  ctaHeadline = '',
  ctaText = '',
  ctaButtonText = '',
  ctaButtonLink = '',
} = Astro.props;

const hasCta = Boolean(ctaHeadline && ctaText && ctaButtonText && ctaButtonLink);

const teamImageBase = 'https://pagesmith-cdn.com/881ce63c/images/images/EV3A6344-Enhanced-NR';

const awards = [
  {
    src: 'https://pagesmith-cdn.com/881ce63c/images/693a1090d3d0960b5ee46445_45-Years-in-Business-184.webp',
    alt: '45 Years of Excellence',
  },
  {
    src: 'https://pagesmith-cdn.com/881ce63c/images/697014f3d508898f484c6001_Iafrate_James_2026-288.webp',
    alt: 'Leading Lawyers peer-selected James A. Iafrate',
  },
  {
    src: 'https://pagesmith-cdn.com/881ce63c/images/693a10d209b58daf0e31988a_super-lawyers-award-188.webp',
    alt: 'Super Lawyers recognition',
  },
];
---

<aside class="self-stretch bg-[#f8f8f8]" aria-label="Practice area resources">
  <nav class="border-b border-black/10 px-6 py-7 text-left" aria-label="Table of contents" data-practice-area-toc hidden>
    <h2 class="font-serif text-[24px] font-bold leading-[1.3] text-foreground">On This Page</h2>
    <ol class="mt-4" data-practice-area-toc-list></ol>
  </nav>

  {hasCta && (
    <section
      class="relative mx-4 mt-5 overflow-hidden rounded-[8px] bg-dark-background px-6 py-7 text-left text-dark-foreground shadow-[0_12px_30px_rgba(1,21,48,0.16)]"
      aria-labelledby="practice-area-sidebar-cta-title"
      data-practice-area-cta
    >
      <div class="absolute inset-x-0 top-0 h-1 bg-primary" aria-hidden="true"></div>
      <p class="mb-3 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#9fc5ff]">Free Case Review</p>
      <h2 id="practice-area-sidebar-cta-title" class="font-serif text-[23px] font-bold leading-[1.25] text-white">
        {ctaHeadline}
      </h2>
      <p class="mt-4 hyphens-none text-[14px] leading-[1.65] text-dark-muted-foreground">{ctaText}</p>
      <a
        href={ctaButtonLink}
        class="mt-6 inline-flex w-full items-center justify-center rounded-[4px] bg-white px-4 py-3 text-center text-[14px] font-semibold leading-[1.35] text-[#011530] no-underline shadow-sm transition-colors hover:bg-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {ctaButtonText}
      </a>
    </section>
  )}

  <div class="px-4 pt-8">
    <img
      src={`${teamImageBase}-768.webp`}
      srcset={`${teamImageBase}-320.webp 320w, ${teamImageBase}-640.webp 640w, ${teamImageBase}-768.webp 768w`}
      sizes="(min-width: 1024px) 293px, calc(100vw - 80px)"
      alt="Adrienne Logeman and James A. Iafrate working together"
      class="h-[240px] w-full rounded-[8px] object-cover object-center"
      loading="lazy"
    />
  </div>

  <div class="px-8 py-8 text-center">
    <h3 class="whitespace-nowrap font-serif text-[24px] font-bold leading-[1.3] text-foreground">Awards and Honors</h3>
    <div class="mt-8 flex flex-col items-center gap-7">
      {awards.map((award) => (
        <div class="flex h-[140px] w-full items-center justify-center">
          <img
            src={award.src}
            alt={award.alt}
            class="max-h-[140px] max-w-full object-contain"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</aside>

<script>
  const createPracticeAreaToc = () => {
    const content = document.querySelector<HTMLElement>('[data-practice-area-content]');
    const toc = document.querySelector<HTMLElement>('[data-practice-area-toc]');
    const list = toc?.querySelector<HTMLOListElement>('[data-practice-area-toc-list]');

    if (!content || !toc || !list) return;

    const headings = Array.from(content.querySelectorAll<HTMLHeadingElement>('h2, h3'))
      .filter((heading) => heading.textContent?.trim());

    if (headings.length === 0) return;

    const usedIds = new Set<string>();
    list.replaceChildren();

    headings.forEach((heading) => {
      const existingId = heading.id.trim();
      const generatedId = heading.textContent!
        .trim()
        .toLowerCase()
        .replace(/&/g, ' and ')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'section';
      const baseId = existingId || `section-${generatedId}`;

      let id = baseId;
      let duplicate = 2;
      while (usedIds.has(id) || (document.getElementById(id) && document.getElementById(id) !== heading)) {
        id = `${baseId}-${duplicate}`;
        duplicate += 1;
      }

      usedIds.add(id);
      heading.id = id;

      const item = document.createElement('li');
      item.dataset.tocDepth = heading.tagName === 'H3' ? '3' : '2';

      const link = document.createElement('a');
      link.href = `#${id}`;
      link.textContent = heading.textContent!.trim();

      item.append(link);
      list.append(item);
    });

    toc.hidden = false;
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', createPracticeAreaToc, { once: true });
  } else {
    createPracticeAreaToc();
  }
</script>

<style is:global>
  [data-practice-area-cta] p {
    hyphens: none;
  }

  [data-practice-area-toc] a {
    display: block;
    padding: 0.4rem 0;
    color: hsl(var(--foreground));
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    transition: color 150ms ease;
  }

  [data-practice-area-toc] a:hover,
  [data-practice-area-toc] a:focus-visible {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  [data-practice-area-toc] [data-toc-depth='3'] {
    padding-left: 1rem;
  }

  [data-practice-area-toc] [data-toc-depth='3'] a {
    font-size: 0.875rem;
    font-weight: 400;
  }

  [data-practice-area-content] h2[id],
  [data-practice-area-content] h3[id] {
    scroll-margin-top: 7rem;
  }
</style>
