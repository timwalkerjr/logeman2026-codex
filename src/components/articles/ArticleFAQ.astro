---
interface Props {
  title?: string;
  items: Array<{ question: string; answer: string }>;
  embedded?: boolean;
}
const { title = "Frequently Asked Questions", items, embedded = false } = Astro.props;
---
<section class:list={["bg-background", embedded ? "pt-12" : "py-16"]}>
  <div class:list={[embedded ? "" : "max-w-[1000px] mx-auto px-6"]}>
    <h2 class:list={["font-bold leading-[1.3] text-foreground tracking-[-0.52px] mb-3", embedded ? "text-[30px] text-left" : "text-[36px] text-center"]}>{title}</h2>
    <p class:list={["text-muted-foreground text-[18px] mb-10", embedded ? "text-left" : "text-center"]}>Find answers to what matters most about your case and how we work.</p>
    <div class="space-y-4">
      {items.map((item) => (
        <details class="bg-secondary p-5 rounded-[12px] group">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-[16px] text-foreground list-none">
            <span>{item.question}</span>
            <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-45" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </summary>
          <p class="mt-4 text-[16px] font-normal leading-[1.6] text-foreground">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
