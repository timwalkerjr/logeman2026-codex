---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<section class="bg-background py-12">
  <div class="max-w-[900px] mx-auto px-6">
    {title && <h1 class="text-[36px] font-bold leading-[1.3] text-foreground tracking-[-0.52px] mb-8">{title}</h1>}
    <div class="prose prose-lg max-w-none text-foreground [&_h2]:text-[26px] [&_h2]:font-bold [&_h2]:leading-[1.3] [&_h2]:tracking-[-0.44px] [&_h2]:text-foreground [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-[20px] [&_h3]:font-semibold [&_h3]:leading-[1.4] [&_h3]:tracking-[-0.28px] [&_h3]:text-foreground [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:text-[16px] [&_p]:font-normal [&_p]:leading-[1.6] [&_p]:text-foreground [&_p]:mb-4 [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 [&_strong]:font-semibold [&_strong]:text-foreground [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-2 [&_li]:text-[16px] [&_li]:leading-[1.6] [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-6">
      <slot />
    </div>
  </div>
</section>