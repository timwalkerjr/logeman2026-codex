---
export interface FAQItem {
  question: string;
  answer: string;
}
export interface Props {
  items: FAQItem[];
}
const { items } = Astro.props;
---

<section id="practice-area-faq" class="bg-[rgba(229,236,246,0.54)] py-16 lg:py-20">
  <div class="max-w-[1000px] mx-auto px-6">
    <div class="text-center mb-10">
      <h2 class="text-[36px] font-bold leading-[1.3] text-foreground mb-3" style="font-family: 'Playfair Display', serif;">
        Frequently Asked Questions
      </h2>
      <p class="text-muted-foreground text-[18px]">Find answers to common questions about our services and process.</p>
    </div>

    <div class="space-y-4">
      {items.map((item, idx) => (
        <details class="bg-secondary rounded-[12px] p-5 group" open={idx === 0}>
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="text-[18px] font-semibold text-foreground pr-4">{item.question}</h3>
            <span class="shrink-0 w-8 h-8 rounded-full bg-white text-primary flex items-center justify-center text-[20px] font-bold transition-transform group-open:rotate-45">
              +
            </span>
          </summary>
          <div class="mt-4 text-[16px] text-foreground leading-[1.7]">
            {item.answer}
          </div>
        </details>
      ))}
    </div>

    <div class="text-center mt-10">
      <p class="text-[18px] text-foreground font-semibold mb-2">Still have questions?</p>
      <p class="text-muted-foreground mb-5">Reach out to us directly for answers.</p>
      <a
        href="#free-consultation"
        class="inline-block bg-primary text-white px-6 py-3 rounded-[4px] font-medium hover:bg-primary-hover transition-colors"
      >
        Schedule a Free Consultation
      </a>
    </div>
  </div>
</section>
