---
export interface Props {
  title: string;
  lastUpdated?: string;
}
const { title, lastUpdated } = Astro.props;
---

<section class="bg-background py-12 lg:py-16">
  <div class="max-w-[1100px] mx-auto px-6">
    <div class="mb-10">
      <h1 class="text-[36px] lg:text-[44px] font-bold leading-[1.25] text-foreground mb-4" style="font-family: 'Playfair Display', serif;">
        {title}
      </h1>
      {lastUpdated && (
        <p class="text-[14px] text-muted-foreground italic">{lastUpdated}</p>
      )}
    </div>
    <div class="prose prose-lg max-w-none text-foreground [&_h2]:text-[28px] [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-foreground [&_h3]:text-[22px] [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:text-foreground [&_h4]:text-[18px] [&_h4]:font-semibold [&_h4]:mt-5 [&_h4]:mb-2 [&_p]:mb-4 [&_p]:text-[16px] [&_p]:leading-[1.7] [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-2 [&_li]:text-[16px] [&_a]:text-primary [&_a]:underline [&_strong]:font-semibold">
      <slot />
    </div>
  </div>
</section>
