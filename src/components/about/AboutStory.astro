---
const team = [
  {
    name: "Adrienne Logeman",
    role: "Partner",
    image: "https://pagesmith-cdn.com/881ce63c/images/693a55d51fbe67b78602b72b_EV3A7457-Enhanced-NR-1536.webp",
    bio: "Ms. Logeman is a practicing lawyer since 2002 in Ann Arbor, Michigan. She received her bachelors from University of Michigan in bio-psychology/neuroscience. She received her law degree from Michigan State Law School. She also served on the Board of Directors for Eversight and volunteers with Donate for Life...",
    link: "/attorney/adrienne-d-logeman",
    tag: "We are fierce advocates"
  },
  {
    name: "Our Verdicts & Settlements",
    role: "Results",
    image: "https://pagesmith-cdn.com/881ce63c/images/693497142d3f9984e2edc6a5_relume-608159-1024.webp",
    bio: "For over forty-five years lawyers at our personal injury law firm have helped accident victims recover the compensation they need to rebuild their lives and take care of their families. Our attorneys are highly experienced and supported by well-trained staff. Their successful advocacy is highlighted by the fact that they have...",
    link: "/verdicts-and-settlements",
    tag: "Fierce advocates"
  },
  {
    name: "Highly Respected and Rated",
    role: "Reviews",
    image: "https://pagesmith-cdn.com/881ce63c/images/693a3279b189ce9cf4d4920c_image-0109-640.webp",
    bio: "We have worked hard to earn the respect and gratitude of our clients. We are so grateful when they take the time to share their experience with us by leaving a review. Thank you to all those who did.",
    link: "/client-testimonials",
    tag: "Trial ready advocates"
  },
  {
    name: "James A. Iafrate",
    role: "Partner",
    image: "https://pagesmith-cdn.com/881ce63c/images/693a53edf7b9715e7b7f58e3_james-a-iafrate-bio-photo-1024.webp",
    bio: "Licensed to practice law in Michigan since 1989, attorney James A. Iafrate has been serving clients at the Logeman & Iafrate, P.C., in Ann Arbor, Michigan, for the last 36 years. Over these years, he has built a commendable legal career focusing on a variety of personal injury cases. His practice areas include handling cases...",
    link: "/attorney/james-a-iafrate",
    tag: "We are fierce advocates"
  }
];
---
<section class="bg-background py-16">
  <div class="max-w-[1440px] mx-auto px-6">
    <div class="text-center max-w-[900px] mx-auto mb-12">
      <p class="text-[14px] text-primary font-medium mb-2 uppercase tracking-wide">Our story</p>
      <h2 class="text-[36px] font-bold leading-[1.3] text-foreground tracking-[-0.52px] mb-4">Built on experience and determination</h2>
      <p class="text-[16px] font-normal leading-[1.6] text-foreground">For decades, Logeman & Iafrate has represented injured clients across Michigan with unwavering commitment. We take cases others won't, and we win cases others can't. Our founders built this firm on a simple principle: injured people deserve fierce advocacy and real results.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {team.map((person) => (
        <article class="bg-[rgba(229,236,246,0.54)] rounded-[8px] border border-white/60 overflow-hidden flex flex-col hover-lift">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={person.image} alt={person.name} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="p-6 flex flex-col flex-1">
            <span class="text-[14px] text-primary font-medium mb-1">{person.role}</span>
            <h3 class="text-[20px] font-semibold leading-[1.4] text-foreground tracking-[-0.28px] mb-3">{person.name}</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-foreground flex-1">{person.bio}</p>
            <a href={person.link} class="inline-flex items-center gap-2 mt-4 bg-[rgba(204,218,238,0.31)] border border-white text-foreground px-4 py-2 rounded-[4px] font-medium text-[14px] hover:bg-white transition-colors">
              Learn more
              <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
