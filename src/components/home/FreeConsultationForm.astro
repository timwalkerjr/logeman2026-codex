---
// Free Case Review Contact Form Section
---

<section id="free-consultation" class="bg-surface py-16 lg:py-20" data-ps="src/components/home/FreeConsultationForm.astro:2ob5k">
  <div class="max-w-[1440px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start" data-ps="src/components/home/FreeConsultationForm.astro:2rk63l">
    <!-- Left Column -->
    <div class="space-y-6 text-left" data-ps="src/components/home/FreeConsultationForm.astro:2rk63m">
      <img
        src="https://pagesmith-cdn.com/881ce63c/images/6941b18a1fbcadfc33d9874c_Logo-320.webp"
        alt="Logeman & Iafrate, P.C."
        class="w-20 h-auto object-contain"
        loading="lazy" data-ps="src/components/home/FreeConsultationForm.astro:9b1rg" />
      <h2 class="font-bold leading-[1.3] text-foreground font-serif text-[26px]" data-ps="src/components/home/FreeConsultationForm.astro:en8v8h">
        Schedule a Free Case Review with a Lawyer
      </h2>
      <p class="text-[16px] text-foreground leading-[1.6]" data-ps="src/components/home/FreeConsultationForm.astro:qytzpd">
        Don't face this alone. Let us review your case and show you what's possible. We never charge legal fees unless we recover damages on your behalf and the initial consultation is free as well. Reach out to us today.
      </p>

      <!-- Attorney Profiles Row -->
      <div class="flex flex-wrap items-center gap-8 pt-4" data-ps="src/components/home/FreeConsultationForm.astro:2rk63n">
        <div class="flex items-center gap-3" data-ps="src/components/home/FreeConsultationForm.astro:2rk63o">
          <img
            src="https://pagesmith-cdn.com/881ce63c/images/693a55d51fbe67b78602b72b_EV3A7457-Enhanced-NR-1024.webp"
            alt="Adrienne D. Logeman"
            class="w-14 h-14 rounded-full object-cover border border-black/10"
            loading="lazy" data-ps="src/components/home/FreeConsultationForm.astro:9b1rh" />
          <div data-ps="src/components/home/FreeConsultationForm.astro:2rk63p">
            <p class="font-bold text-[15px] text-foreground font-serif" data-ps="src/components/home/FreeConsultationForm.astro:qytzpc">Adrienne D. Logeman</p>
            <p class="text-[13px] text-muted-foreground" data-ps="src/components/home/FreeConsultationForm.astro:qytzpb">Partner</p>
          </div>
        </div>

        <div class="flex items-center gap-3" data-ps="src/components/home/FreeConsultationForm.astro:2rk63q">
          <img
            src="https://pagesmith-cdn.com/881ce63c/images/693a53edf7b9715e7b7f58e3_james-a-iafrate-bio-photo-1024.webp"
            alt="James A. Iafrate"
            class="w-14 h-14 rounded-full object-cover border border-black/10"
            loading="lazy" data-ps="src/components/home/FreeConsultationForm.astro:9b1s3" />
          <div data-ps="src/components/home/FreeConsultationForm.astro:2rk63r">
            <p class="font-bold text-[15px] text-foreground font-serif" data-ps="src/components/home/FreeConsultationForm.astro:qytzpa">James A. Iafrate</p>
            <p class="text-[13px] text-muted-foreground" data-ps="src/components/home/FreeConsultationForm.astro:qytzp9">Partner</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Form -->
    <div class="bg-[rgba(229,236,246,0.54)] p-8 rounded-[8px] border border-white/60 shadow-sm" data-ps="src/components/home/FreeConsultationForm.astro:2rk63s">
      <form id="consultation-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/FreeConsultationForm.astro:6s915s">
          <div data-ps="src/components/home/FreeConsultationForm.astro:6s915r">
            <label for="firstName" class="block text-[14px] font-medium text-foreground mb-1" data-ps="src/components/home/FreeConsultationForm.astro:xsnuiz">First name</label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              required
              class="w-full px-3.5 py-2.5 bg-white border border-black/10 rounded-[4px] text-[15px] focus:outline-none focus:border-primary"
            />
          </div>
          <div data-ps="src/components/home/FreeConsultationForm.astro:6s915q">
            <label for="lastName" class="block text-[14px] font-medium text-foreground mb-1" data-ps="src/components/home/FreeConsultationForm.astro:xsnuj0">Last name</label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              required
              class="w-full px-3.5 py-2.5 bg-white border border-black/10 rounded-[4px] text-[15px] focus:outline-none focus:border-primary"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/FreeConsultationForm.astro:6s915p">
          <div data-ps="src/components/home/FreeConsultationForm.astro:6s915o">
            <label for="email" class="block text-[14px] font-medium text-foreground mb-1" data-ps="src/components/home/FreeConsultationForm.astro:xsnuj1">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-3.5 py-2.5 bg-white border border-black/10 rounded-[4px] text-[15px] focus:outline-none focus:border-primary"
            />
          </div>
          <div data-ps="src/components/home/FreeConsultationForm.astro:6s915n">
            <label for="phone" class="block text-[14px] font-medium text-foreground mb-1" data-ps="src/components/home/FreeConsultationForm.astro:xsnuj2">Phone number</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-3.5 py-2.5 bg-white border border-black/10 rounded-[4px] text-[15px] focus:outline-none focus:border-primary"
            />
          </div>
        </div>

        <div data-ps="src/components/home/FreeConsultationForm.astro:6s915m">
          <label for="caseType" class="block text-[14px] font-medium text-foreground mb-1" data-ps="src/components/home/FreeConsultationForm.astro:xsnuj3">What is your case about?</label>
          <select
            id="caseType"
            name="caseType"
            class="w-full px-3.5 py-2.5 bg-white border border-black/10 rounded-[4px] text-[15px] focus:outline-none focus:border-primary"
          >
            <option value="Car Accident">Car Accident</option>
            <option value="Motorcycle Accident">Motorcycle Accident</option>
            <option value="Truck Accident">Truck Accident</option>
            <option value="Bicycle Accident">Bicycle Accident</option>
            <option value="Brain Injury">Brain Injury</option>
            <option value="Spinal Cord Injury">Spinal Cord Injury</option>
            <option value="Wrongful Death">Wrongful Death</option>
            <option value="Other Accident type">Other Accident type</option>
          </select>
        </div>

        <div data-ps="src/components/home/FreeConsultationForm.astro:6s915l">
          <span class="block text-[14px] font-medium text-foreground mb-2" data-ps="src/components/home/FreeConsultationForm.astro:uqwz2b">How would you describe yourself?</span>
          <div class="grid grid-cols-2 gap-2 text-[14px]" data-ps="src/components/home/FreeConsultationForm.astro:6s915k">
            <label class="flex items-center gap-2 cursor-pointer" data-ps="src/components/home/FreeConsultationForm.astro:xsnuj4">
              <input type="radio" name="description" value="Injured person" checked class="text-primary focus:ring-primary" />
              <span data-ps="src/components/home/FreeConsultationForm.astro:uqwz2a">Injured person</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer" data-ps="src/components/home/FreeConsultationForm.astro:xsnuj5">
              <input type="radio" name="description" value="Family member" class="text-primary focus:ring-primary" />
              <span data-ps="src/components/home/FreeConsultationForm.astro:uqwz29">Family member</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer" data-ps="src/components/home/FreeConsultationForm.astro:xsnujr">
              <input type="radio" name="description" value="Legal representative" class="text-primary focus:ring-primary" />
              <span data-ps="src/components/home/FreeConsultationForm.astro:uqwz28">Legal representative</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer" data-ps="src/components/home/FreeConsultationForm.astro:xsnujs">
              <input type="radio" name="description" value="Insurance company" class="text-primary focus:ring-primary" />
              <span data-ps="src/components/home/FreeConsultationForm.astro:uqwz27">Insurance company</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer" data-ps="src/components/home/FreeConsultationForm.astro:xsnujt">
              <input type="radio" name="description" value="Medical provider" class="text-primary focus:ring-primary" />
              <span data-ps="src/components/home/FreeConsultationForm.astro:uqwz26">Medical provider</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer" data-ps="src/components/home/FreeConsultationForm.astro:xsnuju">
              <input type="radio" name="description" value="Other" class="text-primary focus:ring-primary" />
              <span data-ps="src/components/home/FreeConsultationForm.astro:uqwz1k">Other</span>
            </label>
          </div>
        </div>

        <div data-ps="src/components/home/FreeConsultationForm.astro:6s915j">
          <label for="message" class="block text-[14px] font-medium text-foreground mb-1">Message</label>
          <textarea
            id="message"
            name="message"
            rows="3"
            placeholder="Tell us more about what happened"
            class="w-full px-3.5 py-2.5 bg-white border border-black/10 rounded-[4px] text-[15px] focus:outline-none focus:border-primary"
          ></textarea>
        </div>

        <button
          type="submit"
          class="bg-primary text-white border border-primary px-8 py-3 rounded-[4px] font-medium text-[16px] hover:bg-primary-hover transition-colors shadow-sm cursor-pointer"
        >
          Submit
        </button>

        <p id="form-status" class="text-sm font-medium hidden mt-2" data-ps="src/components/home/FreeConsultationForm.astro:qytzp8"></p>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('consultation-form');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    status.textContent = 'Sending...';
    status.className = 'text-sm font-medium text-primary block mt-2';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        status.textContent = 'Thank you. We will be in touch soon.';
        status.className = 'text-sm font-medium text-green-600 block mt-2';
        form.reset();
      } else {
        status.textContent = 'Thank you. We will be in touch soon.';
        status.className = 'text-sm font-medium text-green-600 block mt-2';
      }
    } catch {
      status.textContent = 'Thank you. We will be in touch soon.';
      status.className = 'text-sm font-medium text-green-600 block mt-2';
    }
  });
</script>
