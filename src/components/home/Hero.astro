<section id="hero" class="relative bg-[#FAFAFA] overflow-hidden" data-ps="src/components/home/Hero.astro:c630b">
  <img
    src="https://pagesmith-cdn.com/881ce63c/images/693497a35eaaff8688ef590f_relume-608351-1024.webp"
    alt="Lady Justice with Scales of Law"
    class="absolute inset-0 w-full h-full object-cover object-right pointer-events-none"
    loading="eager"
    fetchpriority="high"
    data-ps="src/components/home/Hero.astro:fibi82"
  />

  <div class="max-w-[1536px] w-full mx-auto px-6 relative z-10 pt-20 pb-8 lg:pt-24 lg:pb-10" data-ps="src/components/home/Hero.astro:ecxgf8">
